<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core & EF Core -->
    <PackageReference Include="Microsoft.AspNetCore.App" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.*" />
    
    <!-- SignalR -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.*" />
    
    <!-- Cache & Session -->
    <PackageReference Include="StackExchange.Redis" Version="2.7.*" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.*" />
    
    <!-- Background Jobs -->
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.*" />
    
    <!-- Payment Gateways -->
    <PackageReference Include="Stripe.net" Version="43.*" />
    <PackageReference Include="PayTR.NET" Version="1.0.*" />
    <PackageReference Include="Iyzipay.Net" Version="3.2.*" />
    
    <!-- Mapping & Validation -->
    <PackageReference Include="AutoMapper" Version="13.*" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="13.*" />
    <PackageReference Include="FluentValidation" Version="11.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="6.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.*" />
    
    <!-- API Documentation -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.*" />
    
    <!-- Email -->
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="MimeKit" Version="4.*" />
    
    <!-- Localization -->
    <PackageReference Include="OrchardCore.Localization" Version="2.*" />
    
    <!-- File Upload -->
    <PackageReference Include="CloudinaryDotNet" Version="1.*" />
    
    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    
    <!-- Security -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot/images/uploads/" />
    <Folder Include="wwwroot/css/" />
    <Folder Include="wwwroot/js/" />
    <Folder Include="Logs/" />
  </ItemGroup>

</Project>